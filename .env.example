# Copy this file to .env and fill in the real value.
# .env is git-ignored and must never be committed.

# API key for the Portkey gateway, which fronts the chat model.
# Without it the backend starts but /api/chat returns an error.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. Defaults shown.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# CHAT_MODEL=gpt-5.6-luna

# Optional, frontend. Where the browser should reach the API.
# Defaults to http://localhost:8000 when unset.
# VITE_API_URL=http://localhost:8000
